# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="PRODUCT"

# Optional modules, comma-separated (e.g. items,content,community; community needs content). Not set = items.
# Use MODULES=none for Core only (an empty value is ignored).
MODULES=items,content,community

# Public base URL of the site, no trailing slash. Used for canonical links, Open Graph
# URLs, sitemap.xml and robots.txt (content module). Set it to the production URL.
SITE_URL=http://localhost:5173

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app

# File storage (any S3-compatible server). Local values below match the `storage`
# container in compose.yml (SeaweedFS). On Vercel use Cloudflare R2, see docs/deploy-vercel.md.
# Backend -> bucket (inside docker compose the backend uses http://storage:8333 instead):
S3_ENDPOINT_URL=http://localhost:9000
# Hostname the BROWSER uses for presigned URLs; leave empty to reuse S3_ENDPOINT_URL
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
# Local dev credentials for the storage container; use long random values on a server
S3_ACCESS_KEY_ID=product-dev-key
S3_SECRET_ACCESS_KEY=product-dev-secret-change-me
S3_BUCKET=product
# Optional permanent public URL prefix for public files (e.g. R2 public bucket domain). Empty = signed URLs only
S3_PUBLIC_BASE_URL=
# Usage limits (defaults shown; keeps R2 inside its free tier). Superusers skip the per-user quota and daily limit
UPLOAD_MAX_BYTES=10485760
STORAGE_TOTAL_LIMIT_BYTES=8589934592
STORAGE_USER_QUOTA_BYTES=104857600
UPLOADS_PER_USER_PER_DAY=50

# Community limits (database counts; superusers are exempt) -> HTTP 429
COMMENTS_PER_USER_PER_HOUR=30
REPORTS_PER_USER_PER_DAY=20
